{
  "name": "taskflow",
  "version": "0.1.0",
  "description": "A workspace-based project management application where users create projects, invite collaborators, organize tasks, track progress, and manage work through a list and a Kanban board.",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "biome check",
    "format": "biome format --write",
    "test": "pnpm test:unit && pnpm test:integration && pnpm test:api && pnpm test:e2e",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:api": "vitest run tests/api",
    "test:e2e": "playwright test",
    "test:playwright": "pnpm test:e2e",
    "db:seed": "prisma db seed",
    "db:generate": "prisma generate",
    "db:push": "prisma db push"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@tanstack/react-query": "^5.105.0",
    "axios": "^1.21.0",
    "better-auth": "^1.7.14",
    "dotenv": "18.0.9",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@playwright/test": "^1.64.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "prisma": "7.10.1",
    "sass": "^1.106.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.11.2"
}
